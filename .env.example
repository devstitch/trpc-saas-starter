# Database Configuration
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database-name
# For Local MongoDB: mongodb://localhost:27017/database-name
DATABASE_URL="mongodb://localhost:27017/trpc-saas"

# Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-key-change-this-in-production-min-32-characters"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS (Optional)
# CORS_ORIGIN="http://localhost:3001"

# Stripe Key
# Stripe Configuration
# Get your secret key from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Stripe Webhook Secret (Optional - only needed for production)

STRIPE_WEBHOOK_SECRET="whsec_..."

STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""





